# UniFi UDM Pro
UDM_IP=192.168.1.1
UNIFI_API_KEY=your_api_key_here

# UniFi usergroup _id for the throttled speed limit profile (0.1 Mbps).
# Reuse the same profile from internet-blocker-for-kids.
# To find it: connect a device, apply the profile, then check via UniFi API.
THROTTLE_PROFILE_ID=your_usergroup_id_here

# How often (seconds) to poll UniFi for active clients (default 300 = 5 min)
POLL_INTERVAL_SECONDS=300

# Active scrolling threshold: bytes/sec above which a device is counted as active
# Default 6250 = 50 kbps
ACTIVE_RATE_THRESHOLD_BYTES_PER_SEC=6250

# Twilio (for SMS OTP only — no quota notifications)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Telegram bot for admin approval and management
# Get TELEGRAM_BOT_TOKEN from @BotFather, TELEGRAM_CHAT_ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Flask secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_string

# Port the portal listens on. Use 80 so UniFi's captive portal redirect works without a custom port.
# The systemd service grants CAP_NET_BIND_SERVICE so port 80 works without running as root.
PORT=80
