# Network interfaces
GUEST_IFACE=eth0
WAN_IFACE=eth1

# IP address of this VM on the guest network (used for absolute poll URLs in captive portal browser)
PORTAL_HOST=192.168.21.2

# LAN devices authorized guests may reach (comma-separated, no spaces).
# Plain "ip" opens all ports on that host; "ip:port" opens only that port
# (e.g. Home Assistant). These bypass the internet-only restriction.
ALLOWED_LAN_IPS=192.168.10.25,192.168.10.37,192.168.10.78,192.168.10.75,192.168.10.100:8123
LAN_SUBNET=192.168.10.0/24

# Throttle speed applied when a guest hits their daily quota.
THROTTLE_DOWN_KBPS=100
THROTTLE_UP_KBPS=100

# How often (seconds) to poll active clients for quota tracking (default 300 = 5 min)
POLL_INTERVAL_SECONDS=300

# Active scrolling threshold: bytes/sec above which a device is counted as active
# Default 6250 = 50 kbps
ACTIVE_RATE_THRESHOLD_BYTES_PER_SEC=6250


# Admin contact info shown on the "not approved" page
ADMIN_EMAIL=you@example.com
ADMIN_PHONE=+4712345678

# WiFi network name used in the SMS sent when a blocked user is approved via /modify
WIFI_NETWORK_NAME=Your Network Name

# Twilio (for SMS OTP and approval notifications)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
# Send a Telegram alert if Twilio balance drops below this amount (USD). Leave unset to disable.
TWILIO_LOW_LIMIT=3.00

# Telegram bot for admin approval and management
# Get TELEGRAM_BOT_TOKEN from @BotFather, TELEGRAM_CHAT_ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Flask secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_string

# Port the captive portal listens on (80 requires CAP_NET_BIND_SERVICE or root)
PORT=80
